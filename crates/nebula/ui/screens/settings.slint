import { Theme, ThemePreference, ButtonKind, SettingsData, SheetActions } from "../tokens.slint";
import { SheetButton } from "../components/button.slint";
import { Field } from "../components/field.slint";
import { ToggleRow } from "../components/toggle-row.slint";

component GroupTitle inherits Text {
    color: Theme.text;
    font-size: 16px;
    font-weight: 700;
}

component GroupRule inherits Rectangle {
    height: 2px;
    vertical-stretch: 0;
    background: Theme.line;
}

component ThemeChoice inherits SheetButton {
    in property <ThemePreference> value;
    exclusive: true;
    selected: SettingsData.theme == root.value;
    a11y-label: "테마 " + root.text;
    activated => {
        SettingsData.theme = root.value;
    }
}

export component Settings inherits VerticalLayout {
    private property <bool> live: !SettingsData.busy;

    spacing: 16px;

    GroupTitle {
        text: "설정";
    }

    Field {
        label: "루트";
        a11y-label: "루트 폴더 경로";
        error: SettingsData.root-error;
        enabled: root.live;
        text <=> SettingsData.root;
    }

    if SettingsData.root-missing : HorizontalLayout {
        alignment: start;
        SheetButton {
            text: "폴더 만들기";
            a11y-label: "루트 폴더 만들기";
            enabled: root.live;
            activated => {
                SheetActions.create-root(SettingsData.root);
            }
        }
    }

    Field {
        label: "기본 URL";
        a11y-label: "배포본 기본 URL";
        helper: "끝에 / 를 붙여 저장합니다";
        error: SettingsData.base-url-error;
        enabled: root.live;
        text <=> SettingsData.base-url;
    }

    Field {
        label: "Java 실행 파일";
        a11y-label: "Java 실행 파일 경로";
        error: SettingsData.java-error;
        enabled: root.live;
        text <=> SettingsData.java;
    }

    Field {
        label: "Helios 데이터 폴더";
        a11y-label: "Helios 데이터 폴더 경로";
        error: SettingsData.helios-error;
        enabled: root.live;
        text <=> SettingsData.helios;
    }

    VerticalLayout {
        spacing: 4px;

        Text {
            text: "테마";
            color: Theme.muted;
            font-size: 12px;
            font-weight: 600;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            height: 44px;

            ThemeChoice {
                text: "시스템";
                value: ThemePreference.system;
                enabled: root.live;
            }

            ThemeChoice {
                text: "라이트";
                value: ThemePreference.light;
                enabled: root.live;
            }

            ThemeChoice {
                text: "다크";
                value: ThemePreference.dark;
                enabled: root.live;
            }
        }
    }

    ToggleRow {
        label: "애니메이션 줄이기";
        a11y-label: "애니메이션 줄이기";
        enabled: root.live;
        checked <=> SettingsData.reduced-motion;
    }

    GroupRule { }

    GroupTitle {
        text: "WebDAV";
    }

    Field {
        label: "업로드 URL";
        a11y-label: "WebDAV 업로드 URL";
        enabled: root.live;
        text <=> SettingsData.webdav-url;
    }

    Field {
        label: "사용자";
        a11y-label: "WebDAV 사용자";
        enabled: root.live;
        text <=> SettingsData.webdav-user;
    }

    Field {
        label: "비밀번호";
        a11y-label: "WebDAV 비밀번호";
        password: true;
        enabled: root.live;
        text <=> SettingsData.webdav-password;
    }

    Field {
        label: "공개 URL";
        a11y-label: "WebDAV 공개 URL";
        helper: "비우면 기본 URL을 사용합니다";
        enabled: root.live;
        text <=> SettingsData.webdav-public-url;
    }

    GroupRule { }

    GroupTitle {
        text: "Google Drive";
    }

    Field {
        label: "클라이언트 ID";
        a11y-label: "Google Drive 클라이언트 ID";
        enabled: root.live;
        text <=> SettingsData.gdrive-client-id;
    }

    Field {
        label: "클라이언트 시크릿";
        a11y-label: "Google Drive 클라이언트 시크릿";
        password: true;
        enabled: root.live;
        text <=> SettingsData.gdrive-client-secret;
    }

    Field {
        label: "폴더 ID";
        a11y-label: "Google Drive 폴더 ID";
        enabled: root.live;
        text <=> SettingsData.gdrive-folder-id;
    }

    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        height: 44px;

        SheetButton {
            text: "Google 계정 연결";
            a11y-label: "Google 계정 연결";
            enabled: root.live;
            activated => {
                SheetActions.connect-gdrive();
            }
        }

        Text {
            text: SettingsData.gdrive-connected ? "연결됨 (토큰 저장됨)" : "연결되지 않음";
            color: SettingsData.gdrive-connected ? Theme.primary : Theme.muted;
            font-family: Theme.mono;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    GroupRule { }

    HorizontalLayout {
        alignment: start;
        height: 48px;

        SheetButton {
            kind: ButtonKind.primary;
            text: SettingsData.busy ? "저장 중" : "저장";
            a11y-label: "설정 저장";
            enabled: root.live;
            loading: SettingsData.busy;
            width: 240px;
            activated => {
                SheetActions.save-settings(SettingsData.root, SettingsData.base-url, SettingsData.java, SettingsData.helios, SettingsData.theme, SettingsData.reduced-motion);
            }
        }
    }

    Rectangle { }
}
