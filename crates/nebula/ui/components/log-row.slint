import { Theme, LogRowData } from "../tokens.slint";

export component LogRow inherits HorizontalLayout {
    in property <LogRowData> data;

    spacing: 8px;
    padding-top: 2px;
    padding-bottom: 2px;

    // Section 3 of the design record: `muted` on `raised` fails AA in light mode,
    // so every column of the log band uses `text`.
    Text {
        text: root.data.time;
        color: Theme.text;
        font-family: Theme.mono;
        font-size: 12px;
        width: 56px;
        horizontal-stretch: 0;
        vertical-alignment: top;
    }

    Text {
        text: root.data.target;
        color: Theme.text;
        font-family: Theme.mono;
        font-size: 12px;
        width: 52px;
        horizontal-stretch: 0;
        vertical-alignment: top;
    }

    Text {
        text: root.data.message;
        color: Theme.text;
        font-family: Theme.mono;
        font-size: 12px;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}
