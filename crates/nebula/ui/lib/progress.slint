import { Theme } from "theme.slint";

/// A 4 px track with an accent fill (DESIGN-v2 §3), always indeterminate: a
/// 30 % segment sliding across the track, driven by `Theme.progress-phase`
/// rather than a Slint `animate` loop — the software renderer only ever draws
/// the first frame of a looping animation into a screenshot, and a host-driven
/// phase can be pinned to any frame for review.
///
/// There is no determinate mode. Nothing this app does reports real progress:
/// a Forge install and an upload both finish when they finish, and a bar that
/// implies otherwise is a fake number.
export component ProgressBar inherits Rectangle {
    in property <length> track: 4px;
    in property <brush> fill: Theme.accent;
    /// What is working. Required wherever the bar is the only thing saying so.
    in property <string> a11y-label;

    height: root.track;
    vertical-stretch: 0;
    background: Theme.surface-3;
    border-radius: root.track / 2;
    // Keeps the sliding segment inside the rounded track.
    clip: true;

    accessible-role: progress-indicator;
    accessible-label: root.a11y-label;

    Rectangle {
        y: 0;
        height: root.track;
        border-radius: root.track / 2;
        background: root.fill;
        width: root.width * 0.3;
        // -0.3w at phase 0 to +1.0w at phase 1: the segment enters from the
        // left edge and leaves at the right.
        x: root.width * (1.3 * Theme.progress-phase - 0.3);
    }
}
