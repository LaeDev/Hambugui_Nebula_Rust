import { ScrollView, ListView } from "std-widgets.slint";
import { Theme, AppPage, ButtonKind, PublishTarget, PublishData, SheetData, SheetActions, ReadinessRowData } from "../tokens.slint";
import { SheetButton } from "../components/button.slint";
import { Field } from "../components/field.slint";
import { ToggleRow } from "../components/toggle-row.slint";
import { ServerRow } from "../components/server-row.slint";
import { FindingRow } from "../components/finding-row.slint";
import { LogRow } from "../components/log-row.slint";
import { Stamp } from "../components/stamp.slint";

component BandRule inherits Rectangle {
    height: 2px;
    vertical-stretch: 0;
    background: Theme.line;
}

component PublishChoice inherits SheetButton {
    in property <PublishTarget> value;
    exclusive: true;
    selected: PublishData.target == root.value;
    a11y-label: "배포 대상 " + root.text;
    activated => {
        PublishData.target = root.value;
    }
}

component BandTitle inherits Text {
    color: Theme.text;
    font-size: 16px;
    font-weight: 700;
    vertical-alignment: center;
}

component ReadinessRow inherits HorizontalLayout {
    in property <ReadinessRowData> data;

    height: 28px;
    spacing: 12px;

    Text {
        text: root.data.label;
        color: Theme.muted;
        font-size: 13px;
        width: 92px;
        horizontal-stretch: 0;
        vertical-alignment: center;
    }

    Text {
        text: root.data.value;
        color: root.data.state == "missing" ? Theme.warning : Theme.text;
        font-family: Theme.mono;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
        horizontal-stretch: 1;
    }

    Text {
        text: root.data.state == "missing" ? "미설정" : "확인됨";
        color: root.data.state == "missing" ? Theme.warning : Theme.primary;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: right;
        width: 52px;
        horizontal-stretch: 0;
    }
}

export component Sheet inherits VerticalLayout {
    private property <bool> live: !SheetData.busy;

    spacing: 16px;

    // ── Readiness ────────────────────────────────────────────────────────────
    VerticalLayout {
        spacing: 0px;
        vertical-stretch: 0;
        for row in SheetData.readiness : ReadinessRow {
            data: row;
        }
    }

    BandRule { }

    // ── Servers ──────────────────────────────────────────────────────────────
    VerticalLayout {
        spacing: 8px;
        vertical-stretch: 0;

        HorizontalLayout {
            spacing: 8px;
            height: 44px;

            BandTitle {
                text: "서버";
                horizontal-stretch: 0;
            }

            Text {
                text: SheetData.servers.length;
                color: Theme.muted;
                font-family: Theme.mono;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            SheetButton {
                text: "모드팩 가져오기";
                a11y-label: "CurseForge 모드팩 가져오기 화면 열기";
                enabled: root.live && SheetData.has-root;
                activated => {
                    SheetData.page = AppPage.import;
                    SheetActions.navigate(AppPage.import);
                }
            }

            SheetButton {
                text: "새 서버";
                a11y-label: "새 서버 만들기 화면 열기";
                enabled: root.live && SheetData.has-root;
                activated => {
                    SheetData.page = AppPage.new-server;
                    SheetActions.navigate(AppPage.new-server);
                }
            }
        }

        if SheetData.servers.length > 0 : ScrollView {
            height: min(SheetData.servers.length * 68px, 236px);
            VerticalLayout {
                spacing: 4px;
                padding-right: 4px;
                for row in SheetData.servers : ServerRow {
                    data: row;
                    enabled: root.live;
                    open-folder => {
                        SheetActions.open-folder(row.path);
                    }
                }
            }
        }

        if SheetData.servers.length == 0 : VerticalLayout {
            spacing: 12px;
            padding-top: 4px;
            padding-bottom: 4px;

            Text {
                text: SheetData.has-root
                    ? "아직 서버가 없습니다. 새 서버를 만들거나 CurseForge 모드팩을 가져오세요."
                    : "루트 폴더를 먼저 설정하세요.";
                color: Theme.muted;
                font-size: 14px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }

            if !SheetData.has-root : HorizontalLayout {
                alignment: start;
                SheetButton {
                    text: "설정 열기";
                    a11y-label: "설정 화면 열기";
                    enabled: root.live;
                    activated => {
                        SheetData.page = AppPage.settings;
                        SheetActions.navigate(AppPage.settings);
                    }
                }
            }
        }
    }

    BandRule { }

    // ── Distribution ─────────────────────────────────────────────────────────
    VerticalLayout {
        spacing: 12px;
        vertical-stretch: 0;

        BandTitle {
            text: "배포본";
            height: 24px;
        }

        if !SheetData.root-initialised : Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.warning;
            border-radius: Theme.radius-field;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "이 루트에는 meta/distrometa.json이 없습니다.";
                    color: Theme.text;
                    font-size: 14px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }

                HorizontalLayout {
                    alignment: start;
                    SheetButton {
                        text: "루트 초기화";
                        a11y-label: "루트 폴더 초기화";
                        enabled: root.live;
                        activated => {
                            SheetActions.init-root();
                        }
                    }
                }
            }
        }

        Field {
            label: "파일 이름";
            a11y-label: "배포본 파일 이름";
            suffix: ".json";
            enabled: root.live;
            text <=> SheetData.distro-name;
        }

        ToggleRow {
            label: "생성 후 Helios 데이터 폴더에 설치";
            a11y-label: "생성 후 Helios 데이터 폴더에 설치";
            enabled: root.live && SheetData.install-local-enabled;
            checked <=> SheetData.install-local;
        }

        HorizontalLayout {
            spacing: 8px;

            ToggleRow {
                label: "Forge 설치 캐시 무효화";
                a11y-label: "Forge 설치 캐시 무효화";
                enabled: root.live;
                checked <=> SheetData.invalidate-cache;
            }

            ToggleRow {
                label: "설치 출력 삭제";
                a11y-label: "설치 출력 삭제";
                enabled: root.live;
                checked <=> SheetData.discard-output;
            }
        }

        if SheetData.busy : Text {
            text: SheetData.busy-label;
            color: Theme.muted;
            font-size: 12px;
            font-weight: 600;
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            height: 48px;

            SheetButton {
                kind: ButtonKind.primary;
                text: SheetData.busy ? "생성 중" : "배포본 생성";
                a11y-label: "배포본 생성";
                enabled: SheetData.can-generate;
                loading: SheetData.busy;
                width: 240px;
                activated => {
                    SheetActions.generate(SheetData.distro-name, SheetData.install-local, SheetData.invalidate-cache, SheetData.discard-output);
                }
            }

            SheetButton {
                text: "기존 파일 검증";
                a11y-label: "이미 저장된 배포본 파일 검증";
                enabled: root.live;
                activated => {
                    SheetActions.validate-existing(SheetData.distro-name);
                }
            }
        }

        if !SheetData.can-generate && !SheetData.busy : Text {
            text: "루트와 기본 URL을 설정하면 생성할 수 있습니다.";
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }

        if SheetData.error-text != "" : Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.danger;
            border-radius: Theme.radius-field;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                Text {
                    text: "생성 실패: " + SheetData.error-text;
                    color: Theme.danger;
                    font-size: 14px;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }

                HorizontalLayout {
                    alignment: start;
                    SheetButton {
                        text: "다시 시도";
                        a11y-label: "배포본 생성 다시 시도";
                        enabled: root.live;
                        activated => {
                            SheetActions.generate(SheetData.distro-name, SheetData.install-local, SheetData.invalidate-cache, SheetData.discard-output);
                        }
                    }
                }
            }
        }

        // A finished run that produced no stamp is a run with errors.
        if SheetData.summary != "" : Text {
            text: SheetData.summary;
            color: SheetData.busy || SheetData.stamped ? Theme.text : Theme.danger;
            font-family: Theme.mono;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }

        if SheetData.findings.length > 0 : VerticalLayout {
            spacing: 0px;
            for row in SheetData.findings : FindingRow {
                data: row;
            }
        }

        if SheetData.stamped : HorizontalLayout {
            padding-top: 8px;
            padding-bottom: 8px;
            alignment: center;
            Stamp {
                hash: SheetData.stamp-hash;
                time: SheetData.stamp-time;
            }
        }
    }

    BandRule { }

    // ── Publish ──────────────────────────────────────────────────────────────
    VerticalLayout {
        spacing: 12px;
        vertical-stretch: 0;

        BandTitle {
            text: "배포";
            height: 24px;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            height: 44px;

            PublishChoice {
                text: "없음";
                value: PublishTarget.none;
                enabled: root.live;
            }

            PublishChoice {
                text: "WebDAV";
                value: PublishTarget.webdav;
                enabled: root.live;
            }

            PublishChoice {
                text: "Google Drive";
                value: PublishTarget.gdrive;
                enabled: root.live;
            }
        }

        if PublishData.target == PublishTarget.gdrive : Text {
            text: "Drive는 CDN이 아닙니다. 100 MB 초과 파일과 다운로드 쿼터에 주의하세요 (README 참고)";
            color: Theme.muted;
            font-size: 12px;
            font-weight: 600;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }

        ToggleRow {
            label: "변경된 파일만 업로드";
            a11y-label: "변경된 파일만 업로드";
            enabled: root.live && PublishData.target != PublishTarget.none;
            checked <=> PublishData.only-changed;
        }

        HorizontalLayout {
            alignment: start;
            height: 44px;

            SheetButton {
                text: "업로드";
                a11y-label: "배포본 업로드";
                enabled: root.live && PublishData.can-publish && PublishData.target != PublishTarget.none;
                activated => {
                    SheetActions.publish(PublishData.target, PublishData.only-changed);
                }
            }
        }

        if PublishData.result-line != "" : Text {
            text: PublishData.result-line;
            color: Theme.text;
            font-family: Theme.mono;
            font-size: 13px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }

        if PublishData.distribution-url != "" : TextInput {
            text: PublishData.distribution-url;
            read-only: true;
            color: Theme.text;
            font-family: Theme.mono;
            font-size: 13px;
            single-line: false;
            wrap: word-wrap;
            selection-background-color: Theme.primary;
            selection-foreground-color: Theme.on-primary;
            accessible-role: text-input;
            accessible-label: "배포 URL";
            horizontal-stretch: 1;
        }
    }

    BandRule { }

    // ── Log ──────────────────────────────────────────────────────────────────
    VerticalLayout {
        spacing: 8px;
        vertical-stretch: 1;
        min-height: 140px;

        HorizontalLayout {
            spacing: 8px;
            height: 44px;

            BandTitle {
                text: "로그";
                horizontal-stretch: 1;
            }

            SheetButton {
                kind: ButtonKind.ghost;
                text: "지우기";
                a11y-label: "로그 지우기";
                enabled: SheetData.log.length > 0;
                activated => {
                    SheetActions.clear-log();
                }
            }
        }

        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius-band;
            vertical-stretch: 1;
            min-height: 96px;

            ListView {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                for row in SheetData.log : LogRow {
                    data: row;
                }
            }
        }
    }
}
