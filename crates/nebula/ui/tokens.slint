import { Palette } from "std-widgets.slint";

export enum ThemePreference { system, light, dark }
export enum AppPage { sheet, new-server, import, settings }
export enum ButtonKind { primary, secondary, ghost }
export enum Loader { none, forge, neoforge, fabric }
export enum PublishTarget { none, webdav, gdrive }

export struct ServerRowData {
    id: string,
    loader: string,
    counts: string,
    path: string,
}

export struct FindingRowData {
    severity: string,
    location: string,
    message: string,
    is-error: bool,
}

export struct LogRowData {
    time: string,
    target: string,
    message: string,
}

export struct ReadinessRowData {
    label: string,
    value: string,
    state: string,
}

export struct ManualDownloadData {
    name: string,
    file: string,
    url: string,
}

export struct ImportRowData {
    file-name: string,
    format: string,
    size-label: string,
    selectable: bool,
}

export global Theme {
    in property <ThemePreference> preference: ThemePreference.system;
    in property <bool> reduced-motion: false;
    // Screenshot aid: renders every focus ring at once so the 2 px ring can be reviewed
    // in a still image. --load-data cannot move keyboard focus.
    in property <bool> focus-demo: false;

    out property <bool> dark: preference == ThemePreference.dark
        ? true
        : preference == ThemePreference.light
            ? false
            : Palette.color-scheme == ColorScheme.dark;

    out property <brush> bg: dark ? #15181D : #E9E4D8;
    out property <brush> surface: dark ? #1E2229 : #F7F4EC;
    out property <brush> raised: dark ? #2A2F38 : #DDD6C4;
    out property <brush> text: dark ? #ECE7DA : #1B1F24;
    out property <brush> muted: dark ? #A8A296 : #5A6170;
    out property <brush> line: dark ? #737B88 : #857D6B;
    out property <brush> primary: dark ? #3FB79F : #14675C;
    out property <brush> on-primary: dark ? #10201C : #F7F4EC;
    out property <brush> focus: dark ? #F2A65A : #B4530D;
    out property <brush> danger: dark ? #FF6B5E : #B3261E;
    out property <brush> warning: dark ? #FFC857 : #8A5A00;

    out property <duration> micro: reduced-motion ? 0ms : 150ms;
    out property <duration> stamp: reduced-motion ? 0ms : 200ms;

    out property <length> radius-band: 0px;
    out property <length> radius-field: 2px;
    out property <length> radius-row: 4px;

    out property <string> mono: "Consolas";
}

export global SheetData {
    in-out property <AppPage> page: AppPage.sheet;

    in property <[ReadinessRowData]> readiness;
    in property <[ServerRowData]> servers;
    in property <[FindingRowData]> findings;
    in property <[LogRowData]> log;

    in property <string> summary;
    in property <bool> stamped;
    in property <string> stamp-hash;
    in property <string> stamp-time;
    in property <bool> busy;
    in property <string> busy-label;
    in property <string> error-text;
    in property <bool> has-root;
    in property <bool> root-initialised: true;
    in property <bool> can-generate;
    in property <bool> install-local-enabled;

    in-out property <string> distro-name: "distribution";
    in-out property <bool> install-local;
    in-out property <bool> invalidate-cache;
    in-out property <bool> discard-output;
}

export global SheetActions {
    callback generate(string, bool, bool, bool);
    callback validate-existing(string);
    callback open-folder(string);
    callback refresh();
    callback init-root();
    callback navigate(AppPage);
    callback create-server(string, string, Loader, string);
    callback lookup-loader-version(Loader, string);
    callback import-modpack(string, string);
    callback save-settings(string, string, string, string, ThemePreference, bool);
    callback create-root(string);
    callback clear-log();
    callback publish(PublishTarget, bool);
    callback connect-gdrive();
}

export global PublishData {
    in-out property <PublishTarget> target: PublishTarget.none;
    in-out property <bool> only-changed: true;

    in property <bool> can-publish;
    in property <string> result-line;
    in property <string> distribution-url;
}

export global NewServerData {
    in-out property <string> id;
    in-out property <string> mc-version;
    in-out property <Loader> loader: Loader.none;
    in-out property <string> loader-version;

    in property <string> id-error;
    in property <string> mc-error;
    in property <string> loader-version-error;
    in property <bool> forge-mod-lists-warning;
    in property <bool> busy;
    in property <bool> lookup-busy;
}

export global ImportData {
    in property <[ImportRowData]> zips;
    in property <[ManualDownloadData]> manual-downloads;
    in property <string> folder-path;
    in property <string> id-error;
    in property <bool> busy;

    in-out property <int> selected-zip: -1;
    in-out property <string> server-id;
}

export global SettingsData {
    in-out property <string> root;
    in-out property <string> base-url;
    in-out property <string> java;
    in-out property <string> helios;
    in-out property <ThemePreference> theme: ThemePreference.system;
    in-out property <bool> reduced-motion;

    in-out property <string> webdav-url;
    in-out property <string> webdav-user;
    in-out property <string> webdav-password;
    in-out property <string> webdav-public-url;

    in-out property <string> gdrive-client-id;
    in-out property <string> gdrive-client-secret;
    in-out property <string> gdrive-folder-id;

    in property <bool> gdrive-connected;
    in property <string> root-error;
    in property <string> base-url-error;
    in property <string> java-error;
    in property <string> helios-error;
    in property <bool> root-missing;
    in property <bool> busy;
}
