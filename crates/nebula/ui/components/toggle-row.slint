import { Theme } from "../tokens.slint";

export component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> a11y-label;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled(bool);

    private property <bool> ring: fs.has-focus || Theme.focus-demo;

    function flip() {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    min-width: 44px;
    min-height: 44px;
    max-height: 44px;
    vertical-stretch: 0;
    border-radius: Theme.radius-field;
    border-width: root.ring ? 2px : 0px;
    border-color: Theme.focus;
    background: touch.has-hover && root.enabled ? Theme.raised : transparent;
    opacity: root.enabled ? 1.0 : 0.72;

    accessible-role: checkbox;
    accessible-label: root.a11y-label == "" ? root.label : root.a11y-label;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        root.flip();
    }
    animate background { duration: Theme.micro; }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.flip();
                accept
            } else {
                reject
            }
        }

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 12px;

            Rectangle {
                width: 18px;
                horizontal-stretch: 0;

                box := Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: Theme.radius-field;
                    border-width: 2px;
                    border-color: root.checked ? Theme.primary : Theme.line;
                    background: root.checked ? Theme.primary : Theme.surface;

                    if root.checked : Path {
                        x: 3px;
                        y: 3px;
                        width: 12px;
                        height: 12px;
                        viewbox-width: 12;
                        viewbox-height: 12;
                        stroke: Theme.on-primary;
                        stroke-width: 2px;
                        commands: "M 1.5 6 L 4.5 9.5 L 10.5 2.5";
                    }
                }
            }

            Text {
                text: root.label;
                color: Theme.text;
                font-size: 14px;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }

        touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                root.flip();
            }
        }
    }
}
