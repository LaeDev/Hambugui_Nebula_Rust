import { Theme } from "theme.slint";
import { Type } from "typography.slint";

/// Centred glyph, one line of what is missing, one of what to do, and up to
/// two buttons the caller passes as children (DESIGN-v2 §3).
export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> body;

    padding-top: Theme.sp-4;
    padding-bottom: Theme.sp-4;
    spacing: Theme.sp-2;
    alignment: center;
    vertical-stretch: 0;

    accessible-role: text;
    accessible-label: root.title + ". " + root.body;

    // A VerticalLayout stretches its children horizontally; an Image keeps its
    // own size and lands on the left, so it needs a row of its own to centre in.
    if root.icon.width > 0 : HorizontalLayout {
        alignment: center;
        Image {
            source: root.icon;
            width: 24px;
            height: 24px;
            image-fit: contain;
            colorize: Theme.text-3;
            accessible-role: none;
        }
    }

    Text {
        text: root.title;
        color: Theme.text;
        font-size: Type.row-title;
        font-weight: Type.medium;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if root.body != "" : Text {
        text: root.body;
        color: Theme.text-2;
        font-size: Type.secondary;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    HorizontalLayout {
        padding-top: Theme.sp-1;
        spacing: Theme.sp-2;
        alignment: center;
        @children
    }
}
