import { Theme } from "../tokens.slint";

// Two Slint 1.17.1 software-renderer facts shaped this component:
//   1. `transform-rotation` is a no-op (an Image and a Text at -30deg both came
//      out upright), so the stamp ships upright instead of tilted -6deg.
//   2. A declared `animate opacity` runs from 0 on the first frame, which leaves
//      the stamp invisible in a headless screenshot and blank for 200 ms at
//      runtime. The design record calls the evidence more important than the
//      flourish, so the stamp has no entry animation.
export component Stamp inherits Rectangle {
    in property <string> hash;
    in property <string> time;

    width: 240px;
    height: 96px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    accessible-role: text;
    accessible-label: "검증 통과, 해시 " + root.hash + ", " + root.time;

    Image {
        source: @image-url("../../assets/stamp-frame.svg");
        colorize: Theme.primary;
        x: 0px;
        y: 0px;
        width: 240px;
        height: 96px;
        image-fit: fill;
    }

    VerticalLayout {
        padding: 16px;
        spacing: 2px;
        alignment: center;

        Text {
            text: "검증 통과";
            color: Theme.primary;
            font-size: 18px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: root.hash;
            color: Theme.primary;
            font-family: Theme.mono;
            font-size: 13px;
            horizontal-alignment: center;
        }

        Text {
            text: root.time;
            color: Theme.primary;
            font-family: Theme.mono;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}
