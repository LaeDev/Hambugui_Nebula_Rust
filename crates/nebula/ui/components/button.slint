import { Theme, ButtonKind } from "../tokens.slint";

export component SheetButton inherits Rectangle {
    in property <string> text;
    in property <string> a11y-label;
    in property <ButtonKind> kind: ButtonKind.secondary;
    in property <bool> enabled: true;
    in property <bool> loading: false;
    in property <bool> selected: false;
    // Set on the members of an exclusive group so the button reports radio-like state.
    in property <bool> exclusive: false;
    callback activated();

    private property <bool> live: root.enabled && !root.loading;
    private property <bool> ring: fs.has-focus || Theme.focus-demo;

    min-width: 44px;
    min-height: 44px;
    horizontal-stretch: 0;
    border-radius: Theme.radius-field;
    border-width: ring ? 2px : (root.kind == ButtonKind.ghost && !root.selected ? 0px : 1px);
    border-color: ring
        ? Theme.focus
        : (root.selected ? Theme.primary : Theme.line);
    background: !root.live
        ? (root.kind == ButtonKind.ghost ? transparent : Theme.raised)
        : (root.kind == ButtonKind.primary
            ? Theme.primary
            : (touch.pressed
                ? Theme.line
                : (touch.has-hover
                    ? Theme.raised
                    : (root.kind == ButtonKind.ghost ? transparent : Theme.surface))));
    opacity: root.live ? 1.0 : 0.72;

    accessible-role: button;
    accessible-label: root.a11y-label;
    accessible-enabled: root.live;
    accessible-checkable: root.exclusive;
    accessible-checked: root.selected;
    accessible-action-default => {
        if (root.live) {
            root.activated();
        }
    }
    animate background { duration: Theme.micro; }

    fs := FocusScope {
        enabled: root.live;
        key-pressed(event) => {
            if ((event.text == " " || event.text == "\n") && root.live) {
                root.activated();
                accept
            } else {
                reject
            }
        }

        HorizontalLayout {
            // Ghost buttons carry no fill, so a narrower inset keeps their label
            // closer to the 24 px page inset the rest of the sheet aligns to.
            padding-left: root.kind == ButtonKind.ghost ? 8px : 16px;
            padding-right: root.kind == ButtonKind.ghost ? 8px : 16px;
            alignment: center;
            Text {
                text: root.loading ? "… " + root.text : root.text;
                color: !root.live
                    ? Theme.text
                    : (root.kind == ButtonKind.primary ? Theme.on-primary : Theme.text);
                font-size: 14px;
                font-weight: root.kind == ButtonKind.primary || root.selected ? 700 : 600;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
            }
        }

        touch := TouchArea {
            enabled: root.live;
            mouse-cursor: root.live ? pointer : default;
            clicked => {
                root.activated();
            }
        }
    }
}
