import { Theme } from "theme.slint";
import { Type } from "typography.slint";

/// Two to four exclusive options in one surface-2 track; the selected one is a
/// raised card with a border (DESIGN-v2 §3). Used for the loader, the publish
/// target and the theme.
export component SegmentedControl inherits Rectangle {
    in property <[string]> options;
    in property <string> a11y-prefix;
    /// Stable handle for automation, kebab-case. Becomes the UIA AutomationId;
    /// the Korean label is a caption and may be reworded.
    in property <string> a11y-id;
    in property <bool> enabled: true;
    /// Per option, parallel to `options`. **Empty (the default) enables every
    /// option**, which is why every existing caller renders unchanged. A
    /// disabled option is dimmed, announces `accessible-enabled: false`, takes
    /// no hover, click or arrow key, and can never become the selection.
    in property <[bool]> option-enabled;
    /// Which option is selected, `-1` for none. Strictly `in`: the control does
    /// not decide its own state. Every caller derives this from the value it
    /// owns and updates that value in `changed`, so a selection the caller
    /// refuses — or rewrites — cannot leave the track showing something else.
    in property <int> selected: 0;
    callback changed(int);

    height: 40px + 2 * Theme.ring-gutter;
    vertical-stretch: 0;
    opacity: root.enabled ? 1.0 : 0.5;
    border-width: (fs.has-focus || Theme.focus-demo) ? Theme.ring-width : 0px;
    border-color: Theme.accent;
    border-radius: Theme.r-md + Theme.ring-gutter;

    // So `forward-focus: namespace` in a dialog body reaches the track rather
    // than nothing (DESIGN-v2 §8.7).
    forward-focus: fs;

    accessible-role: tab-list;
    accessible-label: root.a11y-prefix;
    accessible-id: root.a11y-id;
    accessible-enabled: root.enabled;

    /// A short or empty `option-enabled` leaves the option enabled, so the
    /// property can be omitted entirely.
    pure function option-on(index: int) -> bool {
        root.option-enabled.length <= index || root.option-enabled[index]
    }

    function pick(index: int) {
        if (root.enabled && index >= 0 && index < root.options.length && index != root.selected
            && root.option-on(index)) {
            root.changed(index);
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            // ponytail: one hop. `pick` refuses a disabled neighbour, so the
            // ring never lands on one; hopping *over* it to the next enabled
            // option would need a loop, which a Slint function cannot have.
            // Both of today's callers have two options, where one hop is the
            // whole range.
            if (event.text == Key.LeftArrow) {
                root.pick(max(0, root.selected - 1));
                accept
            } else if (event.text == Key.RightArrow) {
                root.pick(min(root.options.length - 1, root.selected + 1));
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            padding: Theme.ring-gutter;

            Rectangle {
                background: Theme.surface-2;
                border-radius: Theme.r-md;

                HorizontalLayout {
                    padding: 3px;
                    spacing: 3px;

                    for option[index] in root.options : Rectangle {
                        border-radius: Theme.r-sm + 1px;
                        background: root.selected == index
                            ? Theme.surface
                            : (touch.has-hover && root.option-on(index)) ? Theme.surface-3 : transparent;
                        border-width: root.selected == index ? 1px : 0px;
                        border-color: Theme.border;
                        animate background { duration: Theme.fast; }

                        accessible-role: tab;
                        accessible-label: root.a11y-prefix + " " + option;
                        // `theme-0`, `theme-1`, …: one handle per option.
                        accessible-id: root.a11y-id == "" ? "" : root.a11y-id + "-" + index;
                        accessible-enabled: root.enabled && root.option-on(index);
                        accessible-checkable: true;
                        accessible-checked: root.selected == index;
                        accessible-action-default => {
                            root.pick(index);
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;

                            Text {
                                text: option;
                                color: root.selected == index
                                    ? Theme.text
                                    : root.option-on(index) ? Theme.text-2 : Theme.text-3;
                                font-size: Type.button;
                                font-weight: root.selected == index ? Type.semibold : Type.medium;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }

                        touch := TouchArea {
                            enabled: root.enabled && root.option-on(index);
                            mouse-cursor: (root.enabled && root.option-on(index))
                                ? MouseCursor.pointer
                                : MouseCursor.default;
                            clicked => {
                                root.pick(index);
                            }
                        }
                    }
                }
            }
        }
    }
}
